local function addLog(text)
	table.insert(logs, "[" .. os.date("%H:%M:%S") .. "] " .. tostring(text))

	while #logs > 12 do
		table.remove(logs, 1)
	end

	logBox.Text = table.concat(logs, "\n")
end

local function setStatus(text)
	status.Text = "◆ Status: " .. tostring(text)
end

local function makeButton(text, order, special)
	local button = Instance.new("TextButton")
	button.Name = text:gsub("%s+", "")
	button.Size = UDim2.fromScale(1, 0.095)
	button.BackgroundColor3 = special and Color3.fromRGB(50, 42, 30) or Color3.fromRGB(34, 34, 50)
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.fromRGB(240, 242, 255)
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.LayoutOrder = order
	button.AutoButtonColor = false
	button.Parent = buttonContainer

	local stroke = Instance.new("UIStroke")
	stroke.Name = "ButtonBorder"
	stroke.Color = special and Color3.fromRGB(255, 185, 55) or Color3.fromRGB(64, 70, 100)
	stroke.Thickness = 1
	stroke.Transparency = 0.1
	stroke.Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), {
			BackgroundColor3 = special and Color3.fromRGB(70, 54, 30) or Color3.fromRGB(48, 48, 70),
		}):Play()

		TweenService:Create(stroke, TweenInfo.new(0.12), {
			Color = Color3.fromRGB(0, 220, 255),
			Thickness = 2,
		}):Play()
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), {
			BackgroundColor3 = special and Color3.fromRGB(50, 42, 30) or Color3.fromRGB(34, 34, 50),
		}):Play()

		TweenService:Create(stroke, TweenInfo.new(0.12), {
			Color = special and Color3.fromRGB(255, 185, 55) or Color3.fromRGB(64, 70, 100),
			Thickness = 1,
		}):Play()
	end)

	return button
end

local function findRemote(name)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 5)
	if not remotes then
		return nil
	end

	local direct = remotes:FindFirstChild(name)
	if direct then
		return direct
	end

	local admin = remotes:FindFirstChild("AdminRemotes")
	if admin then
		return admin:FindFirstChild(name)
	end

	return nil
end

local function runRemote(remoteName, mode, args)
	local remote = findRemote(remoteName)

	if not remote then
		addLog("remote not found: " .. remoteName)
		setStatus("remote missing")
		return
	end

	if mode == "function" and remote:IsA("RemoteFunction") then
		pcall(function()
			remote:InvokeServer(table.unpack(args or {}))
		end)
	elseif remote:IsA("RemoteEvent") then
		pcall(function()
			remote:FireServer(table.unpack(args or {}))
		end)
	end
end

local function action(label, remoteName, mode, args)
	setStatus(label .. "...")
	addLog("scanning server endpoints")
	task.wait(0.12)
	addLog("found endpoint: " .. remoteName)
	task.wait(0.12)
	addLog("sending payload")
	task.wait(0.08)

	runRemote(remoteName, mode or "event", args or {})

	task.wait(0.18)
	addLog("payload accepted")
	setStatus("processing")
end

