        SearchBox.Text = player.DisplayName
    end)

    return ItemFrame
end

-- ===== Rafraîchir la liste des joueurs =====
local function RefreshPlayerList(filterText)
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("PlayerItem_") then
            child:Destroy()
        end
    end

    local playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerList, player)
        end
    end

    if filterText and filterText ~= "" then
        local lowerFilter = filterText:lower()
        local filtered = {}
        for _, p in ipairs(playerList) do
            if p.DisplayName:lower():find(lowerFilter) or p.Name:lower():find(lowerFilter) then
                table.insert(filtered, p)
            end
        end
        playerList = filtered
    end

    table.sort(playerList, function(a, b)
        return a.DisplayName < b.DisplayName
    end)

    for i, player in ipairs(playerList) do
        CreatePlayerItem(player, i)
    end

    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, (#playerList * 42) + 10)

    -- Réinitialiser la sélection si le joueur sélectionné n'est plus dans la liste
    if state.selectedPlayer then
        local found = false
        for _, p in ipairs(playerList) do
            if p == state.selectedPlayer then
                found = true
                break
            end
        end
        if not found then
            state.selectedPlayer = nil
            if selectedItem then
                selectedItem.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                selectedItem.BackgroundTransparency = 0.15
                selectedItem = nil
            end
        end
    end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
