Track(RunService.Heartbeat:Connect(function(deltaTime)
    local _, humanoid = GetCharacterParts()

    if humanoid then
        if State.SpeedEnabled then
            humanoid.WalkSpeed = State.SpeedValue
        end

        if State.JumpEnabled then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = State.JumpValue
        end

        if State.GodEnabled and humanoid.Health > 0 then
            humanoid.Health = humanoid.MaxHealth
        end
    end

    if State.TeleportContinuous then
        TeleportTimer = TeleportTimer + deltaTime

        if TeleportTimer >= 0.05 then
            TeleportTimer = 0

            if not TeleportToSelectedPlayer() then
                SetContinuousTeleport(false)
            end
        end
    else
        TeleportTimer = 0
    end
end))

Track(RunService.RenderStepped:Connect(function()
    if not State.FlyEnabled then
        return
    end

    local _, humanoid, root = GetCharacterParts()
    local camera = Workspace.CurrentCamera

    if not humanoid
        or not root
        or not camera
        or not FlyBodyVelocity
        or not FlyBodyGyro then
        StopFly()
        return
    end

    local flySpeed = State.FlySpeedValue
    local cameraCFrame = camera.CFrame

    -- LookVector garde l'inclinaison verticale de la caméra.
    -- Regarder vers le haut puis avancer fait donc réellement monter.
    local forward = cameraCFrame.LookVector.Unit
    local right = cameraCFrame.RightVector.Unit
    local worldUp = Vector3.new(0, 1, 0)
    local direction = Vector3.new(0, 0, 0)

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        direction = direction + forward
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        direction = direction - forward
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        direction = direction - right
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        direction = direction + right
    end

    -- Commandes verticales indépendantes de l'inclinaison de la caméra.
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        direction = direction + worldUp
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        direction = direction - worldUp
    end

    -- Sur mobile, transforme la direction horizontale du joystick
    -- dans le repère complet de la caméra, inclinaison comprise.
    if direction.Magnitude == 0 and humanoid.MoveDirection.Magnitude > 0 then
        local moveDirection = humanoid.MoveDirection
        local cameraForwardFlat = Vector3.new(
            cameraCFrame.LookVector.X,
            0,
            cameraCFrame.LookVector.Z
        )

        local cameraRightFlat = Vector3.new(
            cameraCFrame.RightVector.X,
            0,
            cameraCFrame.RightVector.Z
        )

        if cameraForwardFlat.Magnitude > 0.001
            and cameraRightFlat.Magnitude > 0.001 then
            cameraForwardFlat = cameraForwardFlat.Unit
            cameraRightFlat = cameraRightFlat.Unit

            local forwardAmount = moveDirection:Dot(cameraForwardFlat)
            local rightAmount = moveDirection:Dot(cameraRightFlat)

            direction =
                (forward * forwardAmount)
                + (right * rightAmount)
        end
    end

    if direction.Magnitude > 0.001 then
        FlyBodyVelocity.Velocity = direction.Unit * flySpeed
    else
        FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    end

    -- Reprend exactement la rotation 3D de la caméra.
    -- Cela évite les problèmes de CFrame.lookAt lorsque la caméra regarde
    -- presque parfaitement vers le haut ou vers le bas.
    local cameraRotation = cameraCFrame - cameraCFrame.Position
    FlyBodyGyro.CFrame = CFrame.new(root.Position) * cameraRotation
end))

