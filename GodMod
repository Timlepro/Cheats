-- ==================== ESP ====================
function refreshESP()
    if state.espToggle then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                addESPForPlayer(plr)
            end
        end
    else
        for plr, _ in pairs(espData.highlights) do
            removeESPForPlayer(plr)
        end
    end
end

function addESPForPlayer(player)
    if espData.highlights[player] then return end
    local function onCharAdded(char)
        wait(0.2)
        if not state.espToggle then return end
        -- Highlight
        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.fromRGB(255,255,255)
        highlight.OutlineTransparency = 0.3
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = char
        highlight.Parent = char
        espData.highlights[player] = highlight

        -- Billboard
        local bill = Instance.new("BillboardGui")
        bill.Size = UDim2.new(0, 150, 0, 30)
        bill.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        bill.AlwaysOnTop = true
        bill.Parent = char
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1,0,1,0)
        label.BackgroundTransparency = 1
        label.Text = player.DisplayName or player.Name
        label.TextColor3 = Color3.fromRGB(255,255,255)
        label.TextSize = 14
        label.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        label.TextStrokeTransparency = 0.2
        label.Font = Enum.Font.GothamBold
        label.Parent = bill
        espData.billboards[player] = bill
    end
    if player.Character then
        onCharAdded(player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        onCharAdded(char)
    end)
end

function removeESPForPlayer(player)
    if espData.highlights[player] then
        espData.highlights[player]:Destroy()
        espData.highlights[player] = nil
    end
    if espData.billboards[player] then
        espData.billboards[player]:Destroy()
        espData.billboards[player] = nil
    end
end

Players.PlayerAdded:Connect(function(player)
    if state.espToggle then addESPForPlayer(player) end
end)
Players.PlayerRemoving:Connect(function(player)
    removeESPForPlayer(player)
end)

