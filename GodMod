local function getAdaptiveSize()
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

    local width = math.clamp(viewport.X * 0.38, 420, 540)
    local height = math.clamp(viewport.Y * 0.60, 360, 450)

    if UserInputService.TouchEnabled or viewport.X < 700 then
        width = math.max(280, viewport.X - 24)
        height = math.max(280, math.min(viewport.Y - 40, 480))
    end

    return Vector2.new(width, height)
end

local function centerMainFrame()
    expandedSize = getAdaptiveSize()

    if not state.minimized then
        MainFrame.Size = UDim2.fromOffset(expandedSize.X, expandedSize.Y)
    end

    local displayedHeight = state.minimized and 38 or expandedSize.Y

    MainFrame.Position = UDim2.new(
        0.5,
        -expandedSize.X / 2,
        0.5,
        -displayedHeight / 2
    )
end

