-- Gestion du vol (double saut)
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        -- Créer un BodyVelocity dans le torse
        local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
        if torso then
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBodyVelocity.Velocity = Vector3.new(0, flySpeed, 0)
            flyBodyVelocity.Parent = torso
        end
        -- Désactiver la gravité
        Humanoid.PlatformStand = true
        Humanoid.Sit = false
    else
        if flyBodyVelocity then
            flyBodyVelocity:Destroy()
            flyBodyVelocity = nil
        end
        Humanoid.PlatformStand = false
        Humanoid.Sit = false
    end
end

-- Détection double saut
local function onJump()
    local currentTime = tick()
    if currentTime - lastJumpTime < doubleJumpThreshold then
        toggleFly()
    end
    lastJumpTime = currentTime
end

-- Attendre que le joueur ait un Humanoid
local function setupJumpListener()
    if Humanoid then
        Humanoid.Jump:Connect(onJump)
    end
end

setupJumpListener()
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
    setupJumpListener()
    -- réinitialiser le vol si actif
    if flyEnabled then
        flyEnabled = false
        if flyBodyVelocity then
            flyBodyVelocity:Destroy()
            flyBodyVelocity = nil
        end
        Humanoid.PlatformStand = false
    end
end)

-- Gestion du vol avec touches
local function updateFlyVelocity()
    if not flyEnabled then return end
    local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
    if not torso or not flyBodyVelocity then return end

    local camera = workspace.CurrentCamera
    local forward = camera.CFrame.LookVector * Vector3.new(1,0,1)
    local right = camera.CFrame.RightVector * Vector3.new(1,0,1)
    local up = Vector3.new(0,1,0)

    local vel = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + forward
    elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - forward
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - right
    elseif UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + right
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + up
    elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - up
    end

    if vel.Magnitude > 0 then
        vel = vel.Unit * flySpeed
    else
        vel = Vector3.new(0, flySpeed, 0) -- monte par défaut
    end

    flyBodyVelocity.Velocity = vel
end

-- Boucle pour vol et autres mises à jour
RunService.Heartbeat:Connect(function()
    if flyEnabled then
        updateFlyVelocity()
    end
end)

