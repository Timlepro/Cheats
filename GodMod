local function teleportToSelectedPlayer()
    local targetPlayer = state.selectedPlayer

    if not targetPlayer then
        warn("Aucun joueur sélectionné.")
        return false
    end

    local targetCharacter = targetPlayer.Character
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

    local _, _, localRoot = getCharacterParts()

    if not targetRoot or not localRoot then
        warn("Le personnage cible n'est pas disponible.")
        return false
    end

    -- Une valeur positive place le joueur plus bas.
    local verticalOffset = -3.5 - state.teleportDistance
    localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, verticalOffset, 0)

    return true
end

