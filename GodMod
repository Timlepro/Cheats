--==================== Noclip ======================

local function ApplyNoclip()
    local character = Character

    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if NoclipOriginalStates[object] == nil then
                NoclipOriginalStates[object] = object.CanCollide
            end

            object.CanCollide = false
        end
    end
end

local function RestoreNoclip()
    for part, oldCanCollide in pairs(NoclipOriginalStates) do
        if part and part.Parent then
            part.CanCollide = oldCanCollide
        end
    end

    NoclipOriginalStates = {}
end

local function SetNoclip(enabled)
    State.NoclipEnabled = enabled

    if enabled then
        ApplyNoclip()
    else
        RestoreNoclip()
    end

    SetToggleVisual(
        NoclipToggle,
        enabled,
        "Noclip ON",
        "Noclip OFF"
    )
end

--==================== ESP =========================

local function RemoveESPVisuals(player)
    local highlight = ESP.Highlights[player]
    if highlight then
        highlight:Destroy()
        ESP.Highlights[player] = nil
    end

    local billboard = ESP.Billboards[player]
    if billboard then
        billboard:Destroy()
        ESP.Billboards[player] = nil
    end
end

local function ApplyESPToCharacter(player, character)
    RemoveESPVisuals(player)

    if not State.ESPEnabled or not character then
        return
    end

    local adornee = character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")

    if not adornee then
        adornee = character:WaitForChild("HumanoidRootPart", 3)
    end

    if not adornee then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MenuESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 70, 70)
    highlight.FillTransparency = 0.55
    highlight.OutlineColor = COLORS.Text
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    ESP.Highlights[player] = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MenuESPName"
    billboard.Adornee = adornee
    billboard.Size = UDim2.fromOffset(180, 30)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ScreenGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.fromScale(1, 1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    nameLabel.TextColor3 = COLORS.Text
    nameLabel.TextSize = 13
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0.15
    nameLabel.Parent = billboard

    ESP.Billboards[player] = billboard
end

local function BindESPPlayer(player)
    if player == LocalPlayer then
        return
    end

    if ESP.CharacterConnections[player] then
        return
    end

    ESP.CharacterConnections[player] = player.CharacterAdded:Connect(function(character)
        task.wait(0.15)
        ApplyESPToCharacter(player, character)
    end)

    if player.Character then
        ApplyESPToCharacter(player, player.Character)
    end
end

local function UnbindESPPlayer(player)
    RemoveESPVisuals(player)

    local connection = ESP.CharacterConnections[player]
    if connection then
        connection:Disconnect()
        ESP.CharacterConnections[player] = nil
    end
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            BindESPPlayer(player)

            if State.ESPEnabled and player.Character then
                ApplyESPToCharacter(player, player.Character)
            else
                RemoveESPVisuals(player)
            end
        end
    end
end

local function SetESP(enabled)
    State.ESPEnabled = enabled
    RefreshESP()
    SetToggleVisual(ESPToggle, enabled, "ESP ON", "ESP OFF")
end

