Track(UserInputService.JumpRequest:Connect(function()
    local currentTime = os.clock()

    -- Ignore les signaux trop rapprochés produits par un même appui maintenu.
    if currentTime - LastJumpSignal < DoubleJumpMinGap then
        return
    end

    LastJumpSignal = currentTime

    local timeSincePreviousTap = currentTime - LastJumpTap

    if LastJumpTap > 0
        and timeSincePreviousTap >= DoubleJumpMinGap
        and timeSincePreviousTap <= DoubleJumpMaxGap then
        ToggleFly()
        LastJumpTap = 0
        return
    end

    LastJumpTap = currentTime
end))

