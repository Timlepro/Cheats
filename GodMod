-- ===== VOL (double-saut) =====
local function toggleFly()
    state.fly = not state.fly
    if state.fly then
        local torso = getTorso()
        if torso then
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBodyVelocity.Velocity = Vector3.new(0, flySpeed, 0)
            flyBodyVelocity.Parent = torso
        end
        Humanoid.PlatformStand = true
        Humanoid.Sit = false
    else
        if flyBodyVelocity then
            flyBodyVelocity:Destroy()
            flyBodyVelocity = nil
        end
        Humanoid.PlatformStand = false
    end
end

local function onJump()
    local currentTime = tick()
    if currentTime - lastJumpTime < doubleJumpThreshold then
        toggleFly()
    end
    lastJumpTime = currentTime
end

local function setupJump()
    local char, hum = getCharacter()
    hum.Jump:Connect(onJump)
end
setupJump()

-- Gestion du vol en continu
RunService.Heartbeat:Connect(function()
    if state.fly then
        local torso = getTorso()
        if not torso or not flyBodyVelocity then return end
        local camera = workspace.CurrentCamera
        local forward = camera.CFrame.LookVector * Vector3.new(1,0,1)
        local right = camera.CFrame.RightVector * Vector3.new(1,0,1)
        local up = Vector3.new(0,1,0)
        local vel = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + up end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - up end
        if vel.Magnitude > 0 then
            vel = vel.Unit * flySpeed
        else
            vel = Vector3.new(0, flySpeed, 0)
        end
        flyBodyVelocity.Velocity = vel
    end
end)

