local function RefreshPlayerList(filterText)
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton")
            and string.sub(child.Name, 1, 11) == "PlayerItem_" then
            child:Destroy()
        end
    end

    PlayerItems = {}

    local filter = string.lower(filterText or "")
    local visiblePlayers = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local displayName = string.lower(player.DisplayName)
            local username = string.lower(player.Name)

            local matches =
                filter == ""
                or string.find(displayName, filter, 1, true) ~= nil
                or string.find(username, filter, 1, true) ~= nil

            if matches then
                table.insert(visiblePlayers, player)
            end
        end
    end

    table.sort(visiblePlayers, function(a, b)
        return string.lower(a.DisplayName) < string.lower(b.DisplayName)
    end)

    for index, player in ipairs(visiblePlayers) do
        CreatePlayerItem(player, index)
    end

    if State.SelectedPlayer
        and not Players:FindFirstChild(State.SelectedPlayer.Name) then
        State.SelectedPlayer = nil
        SetContinuousTeleport(false)
    end

    UpdateSelectedLabel()
end

