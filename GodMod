        end
    end)

    item.MouseLeave:Connect(function()
        if player ~= state.selectedPlayer then
            item.BackgroundColor3 = COLORS.Element
        end
    end)

    item.MouseButton1Click:Connect(function()
        state.selectedPlayer = player
        updateSelectedLabel()
        updatePlayerSelectionVisuals()
    end)
end

local function refreshPlayerList(filterText)
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") and child.Name:match("^PlayerItem_") then
            child:Destroy()
        end
    end

    table.clear(playerItems)

    local filter = string.lower(filterText or "")
    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local displayName = string.lower(player.DisplayName)
            local userName = string.lower(player.Name)

            if filter == ""
                or string.find(displayName, filter, 1, true)
                or string.find(userName, filter, 1, true) then
                table.insert(list, player)
            end
        end
    end

    table.sort(list, function(a, b)
        return string.lower(a.DisplayName) < string.lower(b.DisplayName)
    end)

    local selectedStillExists = false

    for index, player in ipairs(list) do
        if player == state.selectedPlayer then
            selectedStillExists = true
        end

        createPlayerItem(player, index)
    end

    if state.selectedPlayer
        and not Players:FindFirstChild(state.selectedPlayer.Name) then
        state.selectedPlayer = nil
        stopContinuousTeleport()
    elseif state.selectedPlayer and filter ~= "" and not selectedStillExists then
        -- Le joueur reste sélectionné même s'il est masqué par la recherche.
    end

    updateSelectedLabel()
end

