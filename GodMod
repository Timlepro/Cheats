-- ===== Gestion de la distance =====
local MIN_DISTANCE = -50
local MAX_DISTANCE = 50
local currentDistance = 0

local function UpdateDistanceDisplay(value)
    if value >= 0 then
        DistanceLabel.Text = "📏 " .. string.format("%.1f", value) .. " sous"
    else
        DistanceLabel.Text = "📏 " .. string.format("%.1f", math.abs(value)) .. " au-dessus"
    end
    DistanceBox.Text = string.format("%.1f", value)
    state.teleportDistance = value
end

DistanceBox.FocusLost:Connect(function()
    local val = tonumber(DistanceBox.Text)
    if val then
        val = math.clamp(val, MIN_DISTANCE, MAX_DISTANCE)
        currentDistance = val
        UpdateDistanceDisplay(val)
    else
        DistanceBox.Text = string.format("%.1f", currentDistance)
    end
end)
UpdateDistanceDisplay(0)

-- ===== Fonctions de téléportation =====
local function teleportToPlayer(player, distance)
    if not player then
        warn("Aucun joueur sélectionné")
        return
    end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        warn("Joueur sans personnage")
        return
    end
    local char, _ = getCharacter()
    local localHRP = char:FindFirstChild("HumanoidRootPart")
    if not localHRP then return end
    local targetPos = player.Character.HumanoidRootPart.Position
    local teleportPos = Vector3.new(targetPos.X, targetPos.Y - 3.5 + (distance or 0), targetPos.Z)
    localHRP.CFrame = CFrame.new(teleportPos)
end

local function startContinuousTeleport(player)
    if teleportConnection then teleportConnection:Disconnect() end
    state.teleportContinuous = true
    teleportConnection = RunService.Heartbeat:Connect(function()
        if not state.teleportContinuous then
            stopContinuousTeleport()
            return
        end
        if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            return
        end
        teleportToPlayer(player, state.teleportDistance)
    end)
    TeleportCont.Text = "🔁 ON"
    TeleportCont.BackgroundColor3 = Color3.fromRGB(70, 170, 70)
    TeleportCont.TextColor3 = Color3.fromRGB(220, 255, 220)
end

local function stopContinuousTeleport()
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
    state.teleportContinuous = false
    TeleportCont.Text = "🔁 OFF"
    TeleportCont.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    TeleportCont.TextColor3 = Color3.fromRGB(200, 200, 200)
end

