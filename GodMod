--==================== Utilitaires =================

local function Track(connection)
    table.insert(Connections, connection)
    return connection
end

local function AddCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = object
    return corner
end

local function AddStroke(object, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or COLORS.Border
    stroke.Thickness = thickness or 1
    stroke.Parent = object
    return stroke
end

local function AddPadding(object, left, right, top, bottom)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, left or 0)
    padding.PaddingRight = UDim.new(0, right or 0)
    padding.PaddingTop = UDim.new(0, top or 0)
    padding.PaddingBottom = UDim.new(0, bottom or 0)
    padding.Parent = object
    return padding
end

local function AddListLayout(object, direction, padding)
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = direction or Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, padding or 0)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Top
    layout.Parent = object
    return layout
end

local function CreateLabel(parent, text, height)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, height or 28)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.Text
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

local function CreateButton(parent, text, widthScale)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(widthScale or 1, 0, 1, 0)
    button.BackgroundColor3 = COLORS.Element
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = COLORS.Text
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = false
    button.Parent = parent
    AddCorner(button, 12)
    return button
end

local function CreateTextBox(parent, text, placeholder, widthScale)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(widthScale or 1, 0, 1, 0)
    box.BackgroundColor3 = COLORS.Element
    box.BorderSizePixel = 0
    box.Text = text or ""
    box.PlaceholderText = placeholder or ""
    box.TextColor3 = COLORS.Text
    box.PlaceholderColor3 = COLORS.Muted
    box.TextSize = 12
    box.Font = Enum.Font.GothamMedium
    box.ClearTextOnFocus = false
    box.Parent = parent
    AddCorner(box, 12)
    return box
end

local function CreateSection(parent, titleText, height)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, 0, 0, height)
    section.BackgroundColor3 = COLORS.Panel
    section.BorderSizePixel = 0
    section.Parent = parent
    AddCorner(section, 14)
    AddPadding(section, 10, 10, 8, 8)

    local layout = AddListLayout(section, Enum.FillDirection.Vertical, 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

    local title = CreateLabel(section, titleText, 22)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13

    return section
end

local function CreateRow(parent, height, spacing)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, height or 36)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local layout = AddListLayout(row, Enum.FillDirection.Horizontal, spacing or 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    layout.VerticalAlignment = Enum.VerticalAlignment.Center

    return row
end

local function SetToggleVisual(button, enabled, onText, offText)
    button.Text = enabled and onText or offText
    button.BackgroundColor3 = enabled and COLORS.Green or COLORS.Element
end

local function ParseNumber(text, fallback, minimum, maximum)
    local value = tonumber(text)
    if value == nil then
        return fallback
    end

    return math.clamp(value, minimum, maximum)
end

local function UpdateCharacter(newCharacter)
    Character = newCharacter or LocalPlayer.Character

    if not Character then
        Humanoid = nil
        HumanoidRootPart = nil
        return
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then
        Humanoid = Character:WaitForChild("Humanoid", 5)
    end

    HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then
        HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 5)
    end

    if Humanoid then
        DefaultWalkSpeed = Humanoid.WalkSpeed
        DefaultUseJumpPower = Humanoid.UseJumpPower
        DefaultJumpPower = Humanoid.JumpPower
        DefaultJumpHeight = Humanoid.JumpHeight
    end
end

local function GetCharacterParts()
    if not Character or not Character.Parent then
        UpdateCharacter(LocalPlayer.Character)
    end

    return Character, Humanoid, HumanoidRootPart
end

