local IsMobile = UserInputService.TouchEnabled
local IsSmallScreen = workspace.CurrentCamera.ViewportSize.X < 600

local function GetAdaptiveSize()
    local screenSize = workspace.CurrentCamera.ViewportSize
    local width = math.min(0.40, 0.40) * screenSize.X
    local height = math.min(0.65, 0.65) * screenSize.Y
    if IsMobile or IsSmallScreen then
        width = math.min(0.60, 0.60) * screenSize.X
        height = math.min(0.75, 0.75) * screenSize.Y
    end
    width = math.max(350, width)
    height = math.max(450, height)
    return width, height
end

