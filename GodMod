track(RunService.Heartbeat:Connect(function(deltaTime)
    local _, humanoid = getCharacterParts()

    if humanoid then
        if state.speedEnabled then
            humanoid.WalkSpeed = state.speedValue
        end

        if state.jumpEnabled then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = state.jumpValue
        end

        if state.godEnabled and humanoid.Health > 0 then
            humanoid.Health = humanoid.MaxHealth
        end
    end

    if state.teleportContinuous then
        teleportAccumulator += deltaTime

        if teleportAccumulator >= 0.05 then
            teleportAccumulator = 0

            if not teleportToSelectedPlayer() then
                stopContinuousTeleport()
            end
        end
    else
        teleportAccumulator = 0
    end
end))

track(RunService.RenderStepped:Connect(function()
    if not state.flyEnabled then
        return
    end

    local _, humanoid, root = getCharacterParts()
    local camera = Workspace.CurrentCamera

    if not humanoid
        or not root
        or not camera
        or not flyBodyVelocity
        or not flyBodyGyro then
        stopFly()
        return
    end

    local forward = Vector3.new(
        camera.CFrame.LookVector.X,
        0,
        camera.CFrame.LookVector.Z
    )

    local right = Vector3.new(
        camera.CFrame.RightVector.X,
        0,
        camera.CFrame.RightVector.Z
    )

    if forward.Magnitude > 0 then
        forward = forward.Unit
    end

    if right.Magnitude > 0 then
        right = right.Unit
    end

    local direction = humanoid.MoveDirection
    local velocity = Vector3.zero

    -- Humanoid.MoveDirection fonctionne aussi avec le joystick mobile.
    if direction.Magnitude > 0 then
        velocity += direction.Unit * flySpeed
    else
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            velocity += forward
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            velocity -= forward
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            velocity -= right
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            velocity += right
        end

        if velocity.Magnitude > 0 then
            velocity = velocity.Unit * flySpeed
        end
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        velocity += Vector3.new(0, flySpeed, 0)
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        velocity -= Vector3.new(0, flySpeed, 0)
    end

    flyBodyVelocity.Velocity = velocity
    flyBodyGyro.CFrame = CFrame.lookAt(
        root.Position,
        root.Position + camera.CFrame.LookVector
    )
end))

