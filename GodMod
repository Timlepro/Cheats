local IsMobile = UserInputService.TouchEnabled
local IsSmallScreen = workspace.CurrentCamera.ViewportSize.X < 600

local function GetAdaptiveSize()
    local screenSize = workspace.CurrentCamera.ViewportSize
    local width = math.min(0.35, 0.35) * screenSize.X  -- 35% de la largeur
    local height = math.min(0.50, 0.50) * screenSize.Y -- 50% de la hauteur
    if IsMobile or IsSmallScreen then
        width = math.min(0.50, 0.50) * screenSize.X
        height = math.min(0.60, 0.60) * screenSize.Y
    end
    width = math.max(320, width)
    height = math.max(400, height)
    return width, height
end

