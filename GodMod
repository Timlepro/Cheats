local function bindCameraResize()
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local oldSize = expandedSize
        expandedSize = getAdaptiveSize()

        if not state.minimized then
            MainFrame.Size = UDim2.fromOffset(
                expandedSize.X,
                expandedSize.Y
            )
        else
            MainFrame.Size = UDim2.fromOffset(expandedSize.X, 38)
        end

        if oldSize ~= expandedSize then
            MainFrame.Position = UDim2.new(
                0.5,
                -MainFrame.AbsoluteSize.X / 2,
                0.5,
                -MainFrame.AbsoluteSize.Y / 2
            )
        end
    end))
end

