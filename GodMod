    State.Closed = true
    State.TeleportContinuous = false

    StopFly()
    RestoreMovementValues()
    RestoreNoclip()

    for player, _ in pairs(ESP.CharacterConnections) do
        UnbindESPPlayer(player)
    end

    for _, connection in ipairs(Connections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end

    Connections = {}

    if ScreenGui then
        ScreenGui:Destroy()
    end
end

