--==================== Vol =========================

local function stopFly()
    state.flyEnabled = false

    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end

    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end

    local _, humanoid = getCharacterParts()

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end

    setButtonState(FlyToggle, false, "Vol ON", "Vol OFF")
end

local function startFly()
    local _, humanoid, root = getCharacterParts()

    if not humanoid or not root then
        return
    end

    stopFly()

    state.flyEnabled = true
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    humanoid.Sit = false

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.Name = "MenuFlyVelocity"
    flyBodyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
    flyBodyVelocity.P = 2500
    flyBodyVelocity.Velocity = Vector3.zero
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.Name = "MenuFlyGyro"
    flyBodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
    flyBodyGyro.P = 3000
    flyBodyGyro.CFrame = root.CFrame
    flyBodyGyro.Parent = root

    setButtonState(FlyToggle, true, "Vol ON", "Vol OFF")
end

local function toggleFly()
    if state.flyEnabled then
        stopFly()
    else
        startFly()
    end
end

--==================== Noclip ======================

local function applyNoclip()
    local character = Character

    if not character then
        return
    end

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if noclipOriginalStates[descendant] == nil then
                noclipOriginalStates[descendant] = descendant.CanCollide
            end

            descendant.CanCollide = false
        end
    end
end

local function restoreNoclip()
    for part, originalValue in pairs(noclipOriginalStates) do
        if part and part.Parent then
            part.CanCollide = originalValue
        end
    end

    table.clear(noclipOriginalStates)
end

local function setNoclip(enabled)
    state.noclipEnabled = enabled

    if enabled then
        applyNoclip()
    else
        restoreNoclip()
    end

    setButtonState(
        NoclipToggle,
        enabled,
        "Noclip ON",
        "Noclip OFF"
    )
end

--==================== ESP =========================

local function removeESPVisuals(player)
    local highlight = espData.highlights[player]
    if highlight then
        highlight:Destroy()
        espData.highlights[player] = nil
    end

    local billboard = espData.billboards[player]
    if billboard then
        billboard:Destroy()
        espData.billboards[player] = nil
    end
end

local function applyESPToCharacter(player, character)
    removeESPVisuals(player)

    if not state.espEnabled or not character then
        return
    end

    local head = character:FindFirstChild("Head")
        or character:WaitForChild("Head", 3)

    local root = character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart", 3)

    if not head and not root then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MenuESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 70, 70)
    highlight.FillTransparency = 0.55
    highlight.OutlineColor = COLORS.Text
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    espData.highlights[player] = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MenuESPName"
    billboard.Adornee = head or root
    billboard.Size = UDim2.fromOffset(180, 32)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ScreenGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.fromScale(1, 1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = string.format("%s (@%s)", player.DisplayName, player.Name)
    nameLabel.TextColor3 = COLORS.Text
    nameLabel.TextSize = 13
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0.15
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard

    espData.billboards[player] = billboard
end

local function bindESPPlayer(player)
    if player == LocalPlayer or espData.characterConnections[player] then
        return
    end

    espData.characterConnections[player] = player.CharacterAdded:Connect(function(character)
        task.wait(0.15)
        applyESPToCharacter(player, character)
    end)

    if player.Character then
        applyESPToCharacter(player, player.Character)
    end
end

local function unbindESPPlayer(player)
    removeESPVisuals(player)

    local connection = espData.characterConnections[player]
    if connection then
        connection:Disconnect()
        espData.characterConnections[player] = nil
    end
end

local function refreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            bindESPPlayer(player)

            if state.espEnabled and player.Character then
                applyESPToCharacter(player, player.Character)
            else
                removeESPVisuals(player)
            end
        end
    end
end

local function setESP(enabled)
    state.espEnabled = enabled
    refreshESP()
    setButtonState(ESPToggle, enabled, "ESP ON", "ESP OFF")
end

