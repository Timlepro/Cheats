--==================== Utilitaires =================

local function track(connection)
    table.insert(connections, connection)
    return connection
end

local function addCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = instance
    return corner
end

local function addStroke(instance, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or COLORS.Border
    stroke.Thickness = thickness or 1
    stroke.Parent = instance
    return stroke
end

local function setButtonState(button, enabled, onText, offText)
    button.Text = enabled and onText or offText
    button.BackgroundColor3 = enabled and COLORS.Green or COLORS.Element
    button.TextColor3 = COLORS.Text
end

local function clampNumber(text, defaultValue, minimum, maximum)
    local value = tonumber(text)
    if not value then
        return defaultValue
    end

    return math.clamp(value, minimum, maximum)
end

local function updateCharacter(character)
    Character = character or LocalPlayer.Character

    if not Character then
        Humanoid = nil
        HumanoidRootPart = nil
        return
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")
        or Character:WaitForChild("Humanoid", 5)

    HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        or Character:WaitForChild("HumanoidRootPart", 5)

    if Humanoid then
        if not state.speedEnabled then
            defaultWalkSpeed = Humanoid.WalkSpeed
        end

        if not state.jumpEnabled then
            defaultJumpPower = Humanoid.JumpPower
        end

        Humanoid.UseJumpPower = true
    end
end

local function getCharacterParts()
    if not Character or not Character.Parent then
        updateCharacter(LocalPlayer.Character)
    end

    return Character, Humanoid, HumanoidRootPart
end

