local function ClampFloatCenter(position)
    local viewportSize = GetViewportSize()
    local buttonSize = FloatButton.AbsoluteSize

    local width = buttonSize.X

    if width <= 0 then
        width = FLOAT_BUTTON_SIZE
    end

    local height = buttonSize.Y

    if height <= 0 then
        height = FLOAT_BUTTON_SIZE
    end

    local halfWidth = width / 2
    local halfHeight = height / 2

    local minX = FLOAT_MARGIN + halfWidth
    local maxX = viewportSize.X - FLOAT_MARGIN - halfWidth

    local minY = FLOAT_MARGIN + halfHeight
    local maxY = viewportSize.Y - FLOAT_MARGIN - halfHeight

    if maxX < minX then
        maxX = minX
    end

    if maxY < minY then
        maxY = minY
    end

    return Vector2.new(
        math.clamp(position.X, minX, maxX),
        math.clamp(position.Y, minY, maxY)
    )
end

local function SetFloatCenter(position)
    local viewportSize = GetViewportSize()
    local clampedPosition = ClampFloatCenter(position)

    FloatButton.Position = UDim2.fromOffset(
        clampedPosition.X,
        clampedPosition.Y
    )

    CurrentFloatNormalized = Vector2.new(
        math.clamp(clampedPosition.X / viewportSize.X, 0, 1),
        math.clamp(clampedPosition.Y / viewportSize.Y, 0, 1)
    )
end

-- Réinitialise UNIQUEMENT la position de la popup minimisée.
-- La grande fenêtre MainFrame n'est jamais déplacée par cette fonction.
local function ResetFloatPosition()
    local viewportSize = GetViewportSize()

    SetFloatCenter(Vector2.new(
        viewportSize.X / 2,
        FLOAT_MARGIN + FLOAT_BUTTON_SIZE / 2
    ))

    SavedFloatPosition = {
        CenterX = CurrentFloatNormalized.X,
        CenterY = CurrentFloatNormalized.Y
    }

    SaveToggles()
end

ApplyLoadedFloatPosition = function()
    local viewportSize = GetViewportSize()

    if type(SavedFloatPosition) == "table" then
        local centerX = tonumber(SavedFloatPosition.CenterX)
        local centerY = tonumber(SavedFloatPosition.CenterY)

        if centerX and centerY then
            SetFloatCenter(Vector2.new(
                centerX * viewportSize.X,
                centerY * viewportSize.Y
            ))

            return
        end

        -- Compatibilité avec l'ancien fichier de sauvegarde.
        local oldScaleX = tonumber(SavedFloatPosition.X)
        local oldOffsetX = tonumber(SavedFloatPosition.XOffset)
        local oldScaleY = tonumber(SavedFloatPosition.Y)
        local oldOffsetY = tonumber(SavedFloatPosition.YOffset)

        if oldScaleX and oldScaleY then
            SetFloatCenter(Vector2.new(
                oldScaleX * viewportSize.X
                    + (oldOffsetX or 0)
                    + FLOAT_BUTTON_SIZE / 2,

                oldScaleY * viewportSize.Y
                    + (oldOffsetY or 0)
                    + FLOAT_BUTTON_SIZE / 2
            ))

            return
        end
    end

    -- Position utilisée lorsqu'aucune position n'a encore été enregistrée.
    SetFloatCenter(Vector2.new(
        viewportSize.X / 2,
        FLOAT_MARGIN + FLOAT_BUTTON_SIZE / 2
    ))
end

ApplyLoadedFloatPosition()

local FloatPressed = false
local FloatDragging = false
local FloatDragStart = nil
local FloatStartCenter = nil
local FloatPressTime = 0
local FloatPressedInput = nil

FloatButton.InputBegan:Connect(function(input)
    local validInput =
        input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch

    if not validInput then
        return
    end

    FloatPressed = true
    FloatDragging = false
    FloatDragStart = input.Position
    FloatPressTime = tick()
    FloatPressedInput = input

    local viewportSize = GetViewportSize()

    if CurrentFloatNormalized then
        FloatStartCenter = Vector2.new(
            CurrentFloatNormalized.X * viewportSize.X,
            CurrentFloatNormalized.Y * viewportSize.Y
        )
    else
        FloatStartCenter = Vector2.new(
            FloatButton.AbsolutePosition.X
                + FloatButton.AbsoluteSize.X / 2,

            FloatButton.AbsolutePosition.Y
                + FloatButton.AbsoluteSize.Y / 2
        )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not FloatPressed
        or not FloatDragStart
        or not FloatStartCenter then
        return
    end

    local validInput =
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch

    if not validInput then
        return
    end

    local delta = input.Position - FloatDragStart

    if not FloatDragging then
        if math.abs(delta.X) >= FLOAT_DRAG_DISTANCE
            or math.abs(delta.Y) >= FLOAT_DRAG_DISTANCE then
            FloatDragging = true
        end
    end

    if FloatDragging then
        SetFloatCenter(
            FloatStartCenter
                + Vector2.new(delta.X, delta.Y)
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not FloatPressed then
        return
    end

    local matchingInput = false

    if FloatPressedInput
        and FloatPressedInput.UserInputType == Enum.UserInputType.Touch then
        matchingInput = input == FloatPressedInput
            or input.UserInputType == Enum.UserInputType.Touch
    else
