-- La catégorie est maintenant déterminée UNIQUEMENT par PlaceIds :
-- PlaceIds = {123456}  -> onglet Jeux
-- PlaceIds = {}        -> onglet Universel
local function HasPlaceIds(scriptData)
    return type(scriptData.PlaceIds) == "table"
        and #scriptData.PlaceIds > 0
end

local PlaceNameCache = {}

local function GetPlaceName(placeId)
    placeId = tonumber(placeId)

    if not placeId then
        return "Jeu inconnu"
    end

    if PlaceNameCache[placeId] then
        return PlaceNameCache[placeId]
    end

    local success, info = pcall(function()
        return MarketplaceService:GetProductInfo(
            placeId,
            Enum.InfoType.Asset
        )
    end)

    local placeName

    if success
        and type(info) == "table"
        and type(info.Name) == "string"
        and info.Name ~= "" then

        placeName = info.Name
    else
        placeName = "Jeu #" .. tostring(placeId)
    end

    PlaceNameCache[placeId] = placeName
    return placeName
end

local function GetScriptGameNames(scriptData)
    if not HasPlaceIds(scriptData) then
        return {}
    end

    local names = {}
    local alreadyAdded = {}

    for _, placeId in ipairs(scriptData.PlaceIds) do
        local name = GetPlaceName(placeId)

        if not alreadyAdded[name] then
            alreadyAdded[name] = true
            table.insert(names, name)
        end
    end

    return names
end

