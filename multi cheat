local LastResetPoseTime = 0

local function HandleResetPoseCommand(message)
    if type(message) ~= "string" then
        return
    end

    local normalizedMessage = string.lower(message)
    normalizedMessage = normalizedMessage:gsub("^%s+", ""):gsub("%s+$", "")
    normalizedMessage = normalizedMessage:gsub("%s+", " ")

    if normalizedMessage ~= "/reset pose"
        and normalizedMessage ~= "/resetpose" then
        return
    end

    -- Évite une double exécution si TextChatCommand et Chatted
    -- détectent tous les deux la même commande.
    local now = tick()

    if now - LastResetPoseTime < 0.25 then
        return
    end

    LastResetPoseTime = now
    ResetFloatPosition()
end

