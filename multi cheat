    AutoIndicator.Position = UDim2.new(0.74, 0, 0.55, 0)
    AutoIndicator.BackgroundTransparency = 1
    AutoIndicator.Text = "⏳ En attente"
    AutoIndicator.TextColor3 = Color3.fromRGB(200, 200, 200)
    AutoIndicator.TextSize = GetAdaptiveFontSize() - 5
    AutoIndicator.TextXAlignment = Enum.TextXAlignment.Center
    AutoIndicator.Font = Enum.Font.GothamMedium
    AutoIndicator.ZIndex = 3
    AutoIndicator.Parent = ItemFrame

    local ExecuteButton = Instance.new("TextButton")
    ExecuteButton.Name = "ExecuteButton"

    local buttonWidth, buttonHeight =
        GetAdaptiveButtonSize()

    ExecuteButton.Size = UDim2.new(
        0,
        buttonWidth,
        0,
        buttonHeight
    )

    ExecuteButton.Position = UDim2.new(
        0.78,
        0,
        0.15,
        0
    )

    ExecuteButton.BackgroundColor3 =
        Color3.fromRGB(40, 180, 80)

    ExecuteButton.BackgroundTransparency = 0.2
    ExecuteButton.BorderSizePixel = 0
    ExecuteButton.Text = "▶ Exécuter"
    ExecuteButton.TextColor3 =
        Color3.fromRGB(180, 255, 200)

    ExecuteButton.TextSize =
        GetAdaptiveFontSize() - 4

    ExecuteButton.Font = Enum.Font.GothamBold
    ExecuteButton.AutoButtonColor = false
    ExecuteButton.ZIndex = 3
    ExecuteButton.Parent = ItemFrame

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 5)
    ButtonCorner.Parent = ExecuteButton

    local function RefreshToggleVisual()
        if ScriptToggles[index] then
            ToggleButton.Text = "✅ ACTIVÉ"
            ToggleButton.BackgroundColor3 =
                Color3.fromRGB(40, 180, 80)

            ToggleButton.BorderColor3 =
                Color3.fromRGB(40, 180, 80)

            ToggleButton.TextColor3 =
                Color3.fromRGB(180, 255, 200)
        else
            ToggleButton.Text = "❌ DÉSACTIVÉ"
            ToggleButton.BackgroundColor3 =
                Color3.fromRGB(180, 40, 40)

            ToggleButton.BorderColor3 =
                Color3.fromRGB(180, 40, 40)

            ToggleButton.TextColor3 =
                Color3.fromRGB(255, 180, 180)
        end
    end

    ToggleButton.MouseButton1Click:Connect(function()
        ScriptToggles[index] =
            not ScriptToggles[index]

        RefreshToggleVisual()

        if ScriptToggles[index] then
            ExecutedScripts[index] = false

            if ShouldAutoExecute(scriptData, index) then
                SetAutoIndicator(
                    index,
                    "⏳ Exécution...",
                    Color3.fromRGB(255, 200, 100)
                )

                local success, errorMessage =
                    RunScript(index)

                if success then
                    ExecutedScripts[index] = true

                    SetAutoIndicator(
                        index,
                        "✅ Exécuté",
                        Color3.fromRGB(0, 255, 0)
                    )
                else
                    ExecutedScripts[index] = false

                    SetAutoIndicator(
                        index,
                        "❌ Erreur",
                        Color3.fromRGB(255, 90, 90)
                    )

                    warn(
                        "[ScriptExecutor] Échec de l'exécution de "
                            .. tostring(scriptData.Name)
                            .. " : "
                            .. tostring(errorMessage)
                    )
                end
            end
        else
            ExecutedScripts[index] = false

            SetAutoIndicator(
                index,
                "⏳ En attente",
                Color3.fromRGB(200, 200, 200)
            )
        end

        SaveToggles()
    end)

    ExecuteButton.MouseButton1Click:Connect(function()
        if ExecutingScripts[index] then
            return
        end

        TweenService:Create(
            ExecuteButton,
            TweenInfo.new(0.1),
            {
                Size = UDim2.new(
                    0,
                    buttonWidth - 5,
                    0,
                    buttonHeight - 3
                )
            }
        ):Play()

        task.wait(0.1)

        TweenService:Create(
            ExecuteButton,
            TweenInfo.new(0.1),
            {
                Size = UDim2.new(
                    0,
                    buttonWidth,
                    0,
                    buttonHeight
                )
            }
        ):Play()

        local oldText = ExecuteButton.Text

        ExecuteButton.Text = "⏳..."
        ExecuteButton.TextColor3 =
            Color3.fromRGB(255, 200, 100)

        local success, errorMessage =
            RunScript(index)

        if success then
            ExecuteButton.Text = "✅ Fait !"
            ExecuteButton.TextColor3 =
                Color3.fromRGB(0, 255, 0)

            if ScriptToggles[index]
                and ShouldAutoExecute(scriptData, index) then

                ExecutedScripts[index] = true

                SetAutoIndicator(
                    index,
                    "✅ Exécuté",
                    Color3.fromRGB(0, 255, 0)
                )
            end

            task.wait(0.5)
        else
            ExecuteButton.Text = "❌ Erreur"
            ExecuteButton.TextColor3 =
                Color3.fromRGB(255, 90, 90)

            if ScriptToggles[index] then
                ExecutedScripts[index] = false

                SetAutoIndicator(
                    index,
                    "❌ Erreur",
                    Color3.fromRGB(255, 90, 90)
                )
            end

            warn(
                "[ScriptExecutor] Échec de l'exécution de "
                    .. tostring(scriptData.Name)
                    .. " : "
                    .. tostring(errorMessage)
            )

            task.wait(0.7)
        end

        ExecuteButton.Text = oldText
        ExecuteButton.TextColor3 =
            Color3.fromRGB(180, 255, 200)
    end)

    if not IsMobile then
        ToggleButton.MouseEnter:Connect(function()
            TweenService:Create(
                ToggleButton,
                TweenInfo.new(0.2),
                {
                    BackgroundTransparency = 0.1
                }
            ):Play()
        end)

        ToggleButton.MouseLeave:Connect(function()
            TweenService:Create(
                ToggleButton,
                TweenInfo.new(0.2),
                {
                    BackgroundTransparency = 0.2
                }
            ):Play()
        end)

        ExecuteButton.MouseEnter:Connect(function()
            TweenService:Create(
                ExecuteButton,
                TweenInfo.new(0.2),
                {
                    BackgroundTransparency = 0.1,
                    BackgroundColor3 =
                        Color3.fromRGB(50, 220, 100)
                }
            ):Play()
        end)

        ExecuteButton.MouseLeave:Connect(function()
            TweenService:Create(
                ExecuteButton,
                TweenInfo.new(0.2),
                {
                    BackgroundTransparency = 0.2,
                    BackgroundColor3 =
                        Color3.fromRGB(40, 180, 80)
                }
            ):Play()
        end)
    end

    return ItemFrame
end

for i = 1, #Scripts do
    CreateScriptItem(Scripts[i], i)
end

local function UpdateCanvasSize()
    ScrollFrame.CanvasSize = UDim2.new(
        0,
        0,
        0,
        (#Scripts * 83) + 10
    )
end

UpdateCanvasSize()

UpdateAllScriptVisuals = function()
    if not ScrollFrame then
        return
    end

    for i = 1, #Scripts do
        local item = ScrollFrame:FindFirstChild(
            "ScriptItem_" .. i
        )

        if item then
            local toggle =
                item:FindFirstChild("ToggleButton")

            local indicator =
                item:FindFirstChild("AutoIndicator")

            if toggle then
                if ScriptToggles[i] then
                    toggle.Text = "✅ ACTIVÉ"
                    toggle.BackgroundColor3 =
                        Color3.fromRGB(40, 180, 80)

                    toggle.BorderColor3 =
                        Color3.fromRGB(40, 180, 80)

                    toggle.TextColor3 =
                        Color3.fromRGB(180, 255, 200)
                else
                    toggle.Text = "❌ DÉSACTIVÉ"
                    toggle.BackgroundColor3 =
                        Color3.fromRGB(180, 40, 40)

                    toggle.BorderColor3 =
                        Color3.fromRGB(180, 40, 40)

                    toggle.TextColor3 =
                        Color3.fromRGB(255, 180, 180)
                end
            end

            if indicator then
                if ExecutedScripts[i] then
                    indicator.Text = "✅ Exécuté"
                    indicator.TextColor3 =
                        Color3.fromRGB(0, 255, 0)
                else
                    indicator.Text = "⏳ En attente"
                    indicator.TextColor3 =
                        Color3.fromRGB(200, 200, 200)
                end
            end
        end
    end
end

MinimizeWindow = function()
    SaveToggles()

    MainFrame.Visible = false
    FloatButton.Visible = true

    SetFloatCenter(Vector2.new(
        CurrentFloatNormalized.X * GetViewportSize().X,
        CurrentFloatNormalized.Y * GetViewportSize().Y
    ))

    FloatButton.Size = UDim2.new(0, 35, 0, 35)

    TweenService:Create(
        FloatButton,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.new(
                0,
                FLOAT_BUTTON_SIZE,
                0,
                FLOAT_BUTTON_SIZE
            )
        }
    ):Play()
end

ShowWindow = function()
    MainFrame.Visible = true
    FloatButton.Visible = false
end

CloseWindow = function()
    SaveToggles()

    MainFrame.Visible = false
    FloatButton.Visible = false
end

MinimizeButton.MouseButton1Click:Connect(MinimizeWindow)
CloseButton.MouseButton1Click:Connect(CloseWindow)

local function ReloadToggles()
    LoadConfigData()

    if ApplyLoadedFloatPosition then
        ApplyLoadedFloatPosition()
    end

    if UpdateAllScriptVisuals then
        UpdateAllScriptVisuals()
    end
end

local LastViewportSize = GetViewportSize()

RunService.RenderStepped:Connect(function()
    if game.PlaceId ~= CurrentPlaceId then
        CurrentPlaceId = game.PlaceId

        for i = 1, #Scripts do
            ExecutedScripts[i] = false
            ExecutingScripts[i] = false

            SetAutoIndicator(
                i,
                "⏳ En attente",
                Color3.fromRGB(200, 200, 200)
            )
        end

        task.spawn(ExecuteAutoScripts)
    end

    local currentSize = GetViewportSize()

    if currentSize ~= LastViewportSize then
        LastViewportSize = currentSize

        local isNowSmall = currentSize.X < 600

        if isNowSmall ~= IsSmallScreen then
            IsSmallScreen = isNowSmall
            IsMobile = UserInputService.TouchEnabled
        end

        UpdateMainFrameSize()

        if CurrentFloatNormalized then
            SetFloatCenter(Vector2.new(
                CurrentFloatNormalized.X * currentSize.X,
                CurrentFloatNormalized.Y * currentSize.Y
            ))
        else
            ApplyLoadedFloatPosition()
        end

        local newFontSize = GetAdaptiveFontSize()

        Title.TextSize = newFontSize

        for _, item in ipairs(ScrollFrame:GetChildren()) do
            if item:IsA("Frame")
                and item.Name:match("^ScriptItem_") then

                for _, child in ipairs(item:GetChildren()) do
                    if child:IsA("TextButton") then
                        if child.Name == "ExecuteButton" then
                            local newWidth, newHeight =
                                GetAdaptiveButtonSize()

                            child.Size = UDim2.new(
                                0,
                                newWidth,
                                0,
                                newHeight
                            )

                            child.Position = UDim2.new(
                                0.78,
                                0,
                                0.15,
                                0
                            )

                            child.TextSize =
                                GetAdaptiveFontSize() - 4
                        elseif child.Name == "ToggleButton" then
                            child.TextSize =
                                GetAdaptiveFontSize() - 4
                        end
                    elseif child:IsA("TextLabel") then
                        if child.Name == "ScriptName" then
                            child.TextSize =
                                GetAdaptiveFontSize()
                        elseif child.Name == "PlaceInfo" then
                            child.TextSize =
                                GetAdaptiveFontSize() - 5
                        elseif child.Name == "AutoIndicator" then
                            child.TextSize =
                                GetAdaptiveFontSize() - 5
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    task.wait(2)

    -- Les états ExecutedScripts sont toujours faux au lancement.
    -- Tous les scripts activés peuvent donc être exécutés normalement.
    ExecuteAutoScripts()
end)

