local function ClampFloatCenter(position)
    local viewportSize = GetViewportSize()
    local buttonSize = FloatButton.AbsoluteSize

    local width = buttonSize.X

    if width <= 0 then
        width = FLOAT_BUTTON_SIZE
    end

    local height = buttonSize.Y

    if height <= 0 then
        height = FLOAT_BUTTON_SIZE
    end

    local halfWidth = width / 2
    local halfHeight = height / 2

    local minX = FLOAT_MARGIN + halfWidth
    local maxX = viewportSize.X - FLOAT_MARGIN - halfWidth

    local minY = FLOAT_MARGIN + halfHeight
    local maxY = viewportSize.Y - FLOAT_MARGIN - halfHeight

    if maxX < minX then
        maxX = minX
    end

    if maxY < minY then
        maxY = minY
    end

    return Vector2.new(
        math.clamp(position.X, minX, maxX),
        math.clamp(position.Y, minY, maxY)
    )
end

local function SetFloatCenter(position)
    local viewportSize = GetViewportSize()
    local clampedPosition = ClampFloatCenter(position)

    FloatButton.Position = UDim2.fromOffset(
        clampedPosition.X,
        clampedPosition.Y
    )

    CurrentFloatNormalized = Vector2.new(
        math.clamp(clampedPosition.X / viewportSize.X, 0, 1),
        math.clamp(clampedPosition.Y / viewportSize.Y, 0, 1)
    )
end

ApplyLoadedFloatPosition = function()
    local viewportSize = GetViewportSize()

    if type(SavedFloatPosition) == "table" then
        local centerX = tonumber(SavedFloatPosition.CenterX)
        local centerY = tonumber(SavedFloatPosition.CenterY)

        if centerX and centerY then
            SetFloatCenter(Vector2.new(
                centerX * viewportSize.X,
                centerY * viewportSize.Y
            ))

            return
        end

        -- Compatibilité avec l'ancien fichier de sauvegarde.
        local oldScaleX = tonumber(SavedFloatPosition.X)
        local oldOffsetX = tonumber(SavedFloatPosition.XOffset)
        local oldScaleY = tonumber(SavedFloatPosition.Y)
        local oldOffsetY = tonumber(SavedFloatPosition.YOffset)

        if oldScaleX and oldScaleY then
            SetFloatCenter(Vector2.new(
                oldScaleX * viewportSize.X
                    + (oldOffsetX or 0)
                    + FLOAT_BUTTON_SIZE / 2,

                oldScaleY * viewportSize.Y
                    + (oldOffsetY or 0)
                    + FLOAT_BUTTON_SIZE / 2
            ))

            return
        end
    end

    -- Position utilisée lorsqu'aucune position n'a encore été enregistrée.
    SetFloatCenter(Vector2.new(
        viewportSize.X / 2,
        FLOAT_MARGIN + FLOAT_BUTTON_SIZE / 2
    ))
end

