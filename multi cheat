        and Color3.fromRGB(40, 180, 80)
        or Color3.fromRGB(180, 40, 40)

    ToggleButton.Text =
        ScriptToggles[index]
        and "✅ ACTIVÉ"
        or "❌ DÉSACTIVÉ"

    ToggleButton.TextColor3 =
