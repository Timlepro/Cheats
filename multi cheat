local function GetViewportSize()
    local camera = workspace.CurrentCamera

    if camera and camera.ViewportSize.X > 0 and camera.ViewportSize.Y > 0 then
        return camera.ViewportSize
    end

    return Vector2.new(1920, 1080)
end

local function CanUseFiles()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end

local function GetTableValue(data, index)
    if type(data) ~= "table" then
        return nil
    end

    if data[index] ~= nil then
        return data[index]
    end

    return data[tostring(index)]
end

local function LoadConfigData()
    for i = 1, #Scripts do
        ScriptToggles[i] = false

        -- Ne jamais charger l'ancien état "exécuté".
        -- Chaque nouveau lancement doit pouvoir auto-exécuter les scripts.
        ExecutedScripts[i] = false
        ExecutingScripts[i] = false
    end

    SavedFloatPosition = nil

    if not CanUseFiles() then
        return false
    end

    local fileExistsSuccess, fileExists = pcall(function()
        return isfile(configFile)
    end)

    if not fileExistsSuccess or not fileExists then
        return false
    end

    local readSuccess, jsonData = pcall(function()
        return readfile(configFile)
    end)

    if not readSuccess or type(jsonData) ~= "string" or jsonData == "" then
        return false
    end

    local decodeSuccess, decodedData = pcall(function()
        return HttpService:JSONDecode(jsonData)
    end)

    if not decodeSuccess or type(decodedData) ~= "table" then
        return false
    end

    if type(decodedData.Toggles) == "table" then
        for i = 1, #Scripts do
            local savedToggle = GetTableValue(decodedData.Toggles, i)

            if type(savedToggle) == "boolean" then
                ScriptToggles[i] = savedToggle
            end
        end
    end

    if type(decodedData.FloatPosition) == "table" then
        SavedFloatPosition = decodedData.FloatPosition
    end

    return true
end

local function SaveToggles()
    if not CanUseFiles() then
        return false
    end

    local data = {
        Version = 2,
        Toggles = {},
        FloatPosition = {}
    }

    for i = 1, #Scripts do
        data.Toggles[i] = ScriptToggles[i] == true
    end

    if CurrentFloatNormalized then
        data.FloatPosition = {
            CenterX = CurrentFloatNormalized.X,
            CenterY = CurrentFloatNormalized.Y
        }
    else
        data.FloatPosition = {
            CenterX = 0.5,
            CenterY = 0.05
        }
    end

    local encodeSuccess, jsonData = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not encodeSuccess then
        return false
    end

    local writeSuccess = pcall(function()
        writefile(configFile, jsonData)
    end)

    return writeSuccess
end

