local function ExecuteScript(url, scriptName)
    if type(url) ~= "string" or url == "" then
        return false, "Lien ou code vide"
    end

    if type(loadstring) ~= "function" then
        return false, "loadstring n'est pas disponible"
    end

    local sourceCode = url

    local isUrl =
        string.sub(url, 1, 7) == "http://"
        or string.sub(url, 1, 8) == "https://"

    if isUrl then
        local httpSuccess, response = pcall(function()
            return game:HttpGet(url)
        end)

        if not httpSuccess then
            return false, tostring(response)
        end

        if type(response) ~= "string" or response == "" then
            return false, "Le lien a renvoyé un contenu vide"
        end

        sourceCode = response
    end

    local compiledFunction
    local compileError

    local compileSuccess, compileResult = pcall(function()
        local functionResult, errorResult = loadstring(sourceCode)

        compiledFunction = functionResult
        compileError = errorResult
    end)

    if not compileSuccess then
        return false, tostring(compileResult)
    end

    if type(compiledFunction) ~= "function" then
        return false, tostring(compileError or "Erreur de compilation")
    end

    local executeSuccess, executeError = pcall(compiledFunction)

    if not executeSuccess then
        return false, tostring(executeError)
    end

    return true
end

local function ShouldAutoExecute(scriptData, index)
    if ScriptToggles[index] ~= true then
        return false
    end

    if scriptData.requirePlaceId then
        if type(scriptData.PlaceIds) ~= "table"
            or #scriptData.PlaceIds == 0 then
            return false
        end

        local placeMatches = false

        for _, placeId in ipairs(scriptData.PlaceIds) do
            if tonumber(placeId) == tonumber(CurrentPlaceId) then
                placeMatches = true
                break
            end
        end

        if not placeMatches then
            return false
        end
    end

    return true
end

local function SetAutoIndicator(index, text, color)
    if not ScrollFrame then
        return
    end

    local item = ScrollFrame:FindFirstChild(
        "ScriptItem_" .. index
    )

    if not item then
        return
    end

    local indicator = item:FindFirstChild("AutoIndicator")

    if indicator then
        indicator.Text = text
        indicator.TextColor3 = color
    end
end

local function RunScript(index)
    local scriptData = Scripts[index]

    if not scriptData then
        return false, "Script introuvable"
    end

    if ExecutingScripts[index] then
        return false, "Le script est déjà en cours d'exécution"
    end

    ExecutingScripts[index] = true

    local success, errorMessage = ExecuteScript(
        scriptData.Url,
        scriptData.Name
    )

    ExecutingScripts[index] = false

    return success, errorMessage
end

local function ExecuteAutoScripts()
    for i = 1, #Scripts do
        local scriptData = Scripts[i]

        if ShouldAutoExecute(scriptData, i)
            and not ExecutedScripts[i]
            and not ExecutingScripts[i] then

            SetAutoIndicator(
                i,
                "⏳ Exécution...",
                Color3.fromRGB(255, 200, 100)
            )

            local success, errorMessage = RunScript(i)

            if success then
                ExecutedScripts[i] = true

                SetAutoIndicator(
                    i,
                    "✅ Exécuté",
                    Color3.fromRGB(0, 255, 0)
                )
            else
                ExecutedScripts[i] = false

                SetAutoIndicator(
                    i,
                    "❌ Erreur",
                    Color3.fromRGB(255, 90, 90)
                )

                warn(
                    "[ScriptExecutor] Échec de l'auto-exécution de "
                        .. tostring(scriptData.Name)
                        .. " : "
                        .. tostring(errorMessage)
                )
            end
        end
    end
end

