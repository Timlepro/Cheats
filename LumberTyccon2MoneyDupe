-- Variables pour le RemoteEvent
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local Event = ReplicatedStorage:FindFirstChild("Transactions")
if Event then
    Event = Event:FindFirstChild("ClientToServer")
    if Event then
        Event = Event:FindFirstChild("Donate")
    end
end

-- Variables de cooldown
local isOnCooldown = false
local cooldownTime = 60 -- 60 secondes

-- Fonction pour fermer la GUI (X seulement)
local function CloseGUI()
    ScreenGui:Destroy()
end

-- Fonction pour kick le joueur
local function KickPlayer()
    Player:Kick("💎 Transfert d'argent effectué avec succès!")
end

-- Fonction pour démarrer le cooldown
local function StartCooldown()
    isOnCooldown = true
    local remaining = cooldownTime
    
    -- Désactiver le bouton
    SubmitButton.Visible = false
    CooldownLabel.Visible = true
    
    -- Boucle de cooldown
    while remaining > 0 do
        CooldownLabel.Text = "⏳ Cooldown: " .. remaining .. "s"
        CooldownLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        task.wait(1)
        remaining = remaining - 1
    end
    
    -- Fin du cooldown
    isOnCooldown = false
    CooldownLabel.Visible = false
    SubmitButton.Visible = true
    StatusLabel.Text = "✅ Prêt pour un nouveau transfert!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    -- Effacer le message après 3 secondes
    task.wait(3)
    if not isOnCooldown then
        StatusLabel.Text = ""
    end
end

-- Fonction pour valider le transfert
local function TransferMoney()
    -- Vérifier si en cooldown
    if isOnCooldown then
        StatusLabel.Text = "⏳ Attendez la fin du cooldown!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end
    
    local targetName = PlayerNameBox.Text
    local amount = tonumber(AmountBox.Text)
    
    -- Vérification du nom du joueur
    if targetName == "" then
        StatusLabel.Text = "❌ Erreur: Entrez un pseudo!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    -- Vérification du montant
    if not amount or amount <= 0 then
        StatusLabel.Text = "❌ Erreur: Montant invalide!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    -- Vérification du joueur
    local targetPlayer = Players:FindFirstChild(targetName)
    if not targetPlayer then
        StatusLabel.Text = "❌ Erreur: Joueur non trouvé!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    -- Vérification du RemoteEvent
    if not Event then
        StatusLabel.Text = "❌ Erreur: RemoteEvent non trouvé!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    -- Désactiver le bouton pour éviter les doubles clics
    SubmitButton.Visible = false
    StatusLabel.Text = "⏳ Traitement en cours..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    -- Tentative de transfert
    pcall(function()
        local result = Event:InvokeServer(targetPlayer, amount, 1)
        if result == true or result == nil then
            StatusLabel.Text = "✅ Transfert réussi! " .. amount .. "💰 envoyés à " .. targetName
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            
            -- Vider les champs
            PlayerNameBox.Text = ""
            AmountBox.Text = ""
            
            -- Démarrer le cooldown
            task.spawn(StartCooldown)
            
            -- Kick le joueur après 0.3 secondes
            task.wait(0.3)
            KickPlayer()
        else
            StatusLabel.Text = "❌ Erreur: Transfert échoué!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            SubmitButton.Visible = true
        end
    end)
end

