-- Fonction pour créer un bouton joueur
local function CreatePlayerButton(player)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, 0, 0, 30)
    Button.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    Button.BackgroundTransparency = 0.3
    Button.BorderSizePixel = 0
    Button.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    Button.TextColor3 = Color3.fromRGB(220, 220, 240)
    Button.TextSize = 12
    Button.TextXAlignment = Enum.TextXAlignment.Left
    Button.Font = Enum.Font.SourceSans
    Button.Parent = PlayerListContainer
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.Parent = Button
    BtnCorner.CornerRadius = UDim.new(0, 4)
    
    -- Effet hover
    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        Button.BackgroundTransparency = 0.1
    end)
    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        Button.BackgroundTransparency = 0.3
    end)
    
    -- Sélection du joueur
    Button.MouseButton1Click:Connect(function()
        selectedPlayer = player
        PlayerSearchBox.Text = player.DisplayName
        
        -- Mettre à jour l'apparence de tous les boutons
        for _, btn in pairs(playerButtons) do
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            btn.BackgroundTransparency = 0.3
        end
        Button.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
        Button.BackgroundTransparency = 0.2
        
        StatusLabel.Text = "✅ Joueur sélectionné: " .. player.DisplayName
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end)
    
    return Button
end

-- Fonction pour rafraîchir la liste des joueurs
local function RefreshPlayerList(filterText)
    -- Supprimer les anciens boutons
    for _, child in ipairs(PlayerListContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    playerButtons = {}
    
    local playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerList, player)
        end
    end
    
    -- Filtrer
    if filterText and filterText ~= "" then
        local lowerFilter = filterText:lower()
        local filtered = {}
        for _, p in ipairs(playerList) do
            if p.DisplayName:lower():find(lowerFilter) or p.Name:lower():find(lowerFilter) then
                table.insert(filtered, p)
            end
        end
        playerList = filtered
    end
    
    -- Trier
    table.sort(playerList, function(a, b)
        return a.DisplayName < b.DisplayName
    end)
    
    -- Créer les boutons
    for _, player in ipairs(playerList) do
        local btn = CreatePlayerButton(player)
        table.insert(playerButtons, btn)
    end
    
    -- Mettre à jour la taille du canvas
    PlayerListContainer.CanvasSize = UDim2.new(0, 0, 0, #playerList * 33 + 5)
end

-- Événements de recherche
PlayerSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
