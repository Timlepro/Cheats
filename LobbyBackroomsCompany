-- LocalScript (à mettre dans StarterPlayerScripts ou StarterGui)

local player = game.Players.LocalPlayer
local replicatedStorage = game:GetService("ReplicatedStorage")

-- Récupérer la remote (elle doit déjà exister)
local lobbySetupRemote = replicatedStorage:FindFirstChild("remotes") and replicatedStorage.remotes:FindFirstChild("LobbySetup")

if not lobbySetupRemote then
    warn("❌ Remote LobbySetup introuvable !")
    return
end

-- Création de la GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LobbySetupGUI"
screenGui.Parent = player:WaitForChild("PlayerGui")
