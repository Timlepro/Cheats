    friendAllowed = not friendAllowed
    toggleBtn.BackgroundColor3 = friendAllowed and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    toggleBtn.Text = friendAllowed and "OUI" or "NON"
end)

