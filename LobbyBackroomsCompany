local friendAllowed = false
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 60, 0, 35)
toggleBtn.Position = UDim2.new(0.65, 0, 0, 160)
toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
